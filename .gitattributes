# The reference archive is stored as the bytes it was obtained as, and the index records
# their SHA-256. Git's end-of-line normalisation would rewrite them on checkout and turn
# every recorded hash into a false failure, so these patterns are explicitly binary.
references/*.html -text
references/*.pdf -text
references/*.txt -text
